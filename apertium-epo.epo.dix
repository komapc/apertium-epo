    <!-- komerca konsilisto - multiword with gender! -->
<e>                      <p><l>komerca<b/>konsilisto</l><r>komerca<b/>konsilisto<s n="n"/><s n="m"/><s n="sg"/><s n="nom"/></r></p></e>
<e>                      <p><l>komerca<b/>konsilistino</l><r>komerca<b/>konsilisto<s n="n"/><s n="f"/><s n="sg"/><s n="nom"/></r></p></e>
<e>                      <p><l>komercaj<b/>konsilistoj</l><r>komerca<b/>konsilisto<s n="n"/><s n="m"/><s n="pl"/><s n="nom"/></r></p></e>
<e>                      <p><l>komercaj<b/>konsilistinoj</l><r>komerca<b/>konsilisto<s n="n"/><s n="f"/><s n="pl"/><s n="nom"/></r></p></e>
<e>                      <p><l>komercan<b/>konsiliston</l><r>komerca<b/>konsilisto<s n="n"/><s n="m"/><s n="sg"/><s n="acc"/></r></p></e>
<e>                      <p><l>komercan<b/>konsilistinon</l><r>komerca<b/>konsilisto<s n="n"/><s n="f"/><s n="sg"/><s n="acc"/></r></p></e>
<e>                      <p><l>komercajn<b/>konsilistojn</l><r>komerca<b/>konsilisto<s n="n"/><s n="m"/><s n="pl"/><s n="acc"/></r></p></e>
<e>                      <p><l>komercajn<b/>konsilistinojn</l><r>komerca<b/>konsilisto<s n="n"/><s n="f"/><s n="pl"/><s n="acc"/></r></p></e>

