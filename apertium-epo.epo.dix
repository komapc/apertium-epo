<pardef n="acronimos_regex_par">
<!-- UAB Hospital ^UAB<n><acr><sp>$ ^Hospital<n><sg>$ UABa Hospitalo -->
  <e r="RL"><p><l>a</l>         <r><s n="adj"/><s n="acr"/><s n="re"/></r></p><par n="sgplnomacc"/></e>
  <e r="RL"><p><l></l>          <r><s n="n"/><s n="acr"/><s n="re"/></r></p><par n="sgplnomacc0"/></e>

<!-- Jacob 7sept 2009. En direkto eo->en ni provizore sopozu ke estas nominativo -->
  <e r="LR"><p><l></l>          <r><s n="n"/><s n="acr"/><s n="re"/><s n="sg"/><s n="nom"/></r></p></e>

</pardef>

<pardef n="acronimos">
  <e>       <re>[A-Z][A-Z]</re><par n="acronimos_regex_par"/></e>
  <e>       <re>[A-Z][A-Z][A-Z]</re><par n="acronimos_regex_par"/></e>
  <e>       <re>[A-Z][A-Z][A-Z][A-Z]</re><par n="acronimos_regex_par"/></e>
  <e>       <re>[A-Z][A-Z][A-Z][A-Z][A-Z]</re><par n="acronimos_regex_par"/></e>
</pardef>

<pardef n="ordinals">
  <e>       <re>[0-9]+([.,][0-9]+)?</re><p><l>a</l><r>a<s n="num"/><s n="ord"/></r></p></e>
  <e>       <re>[0-9]+([.,][0-9]+)?</re><p><l>an</l><r>an<s n="num"/><s n="ord"/></r></p></e>
  <e r="LR"><re>[0-9]+([.,][0-9]+)?</re><p><l>aj</l><r>-a<s n="num"/><s n="ord"/></r></p></e>
  <e r="LR"><re>[0-9]+([.,][0-9]+)?</re><p><l>ajn</l><r>-an<s n="num"/><s n="ord"/></r></p></e>
  <e r="LR"><re>[0-9]+([.,][0-9]+)?</re><p><l>-a</l><r>-a<s n="num"/><s n="ord"/></r></p></e>
  <e r="LR"><re>[0-9]+([.,][0-9]+)?</re><p><l>-an</l><r>-an<s n="num"/><s n="ord"/></r></p></e>
  <e r="LR"><re>[0-9]+([.,][0-9]+)?</re><p><l>-aj</l><r>-a<s n="num"/><s n="ord"/></r></p></e>
  <e r="LR"><re>[0-9]+([.,][0-9]+)?</re><p><l>-ajn</l><r>-an<s n="num"/><s n="ord"/></r></p></e>
</pardef>

<pardef n="time">
  <e>       <re>[0-9]+[.:][0-5][0-9](pm|PM|am|AM)</re><p><l></l><r><s n="num"/></r></p></e>
  <e>       <re>[0-9](pm|PM|am|AM)</re><p><l></l><r><s n="num"/></r></p></e>
